+  /// UserDefaults only accepts property-list types. Expo/JS often sends NSNull for
+  /// optional fields (e.g. unlockedDate) — strip those so persist cannot crash.
+  private static func stripNonPropertyListValues(_ value: Any) -> Any? {
+    if value is NSNull {
+      return nil
+    }
+    if let dict = value as? [String: Any] {
+      var out: [String: Any] = [:]
+      for (key, nested) in dict {
+        if let cleaned = stripNonPropertyListValues(nested) {
+          out[key] = cleaned
+        }
+      }
+      return out
+    }
+    if let array = value as? [Any] {
+      return array.compactMap { stripNonPropertyListValues($0) }
+    }
+    return value
   }
 
